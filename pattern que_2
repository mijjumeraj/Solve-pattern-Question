n=int(input('enter any number'))
if n%2!=0:
    for i in range(n//2+1):
        for j in range(i+n//2):
            print(" ",end="")
        for j in range(n-2*i):
            print('@',end="")    
        print()    
    for i in range(n):
        
        for j in range(n):
            if i==0 or j==0 or j==n-1 :  
                
                print("*",end="")
            else:
                print(" ",end='')    
        print() 
else:
    if n==0:
         print('your number is zero')
    else:
        print('your number is even')   
