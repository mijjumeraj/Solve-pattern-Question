n=6
if n%2==0:
    for i in range(n//2):
        for j in range(1):
            print("@",end='')
        print()
    for i in range(n):
        for j in range(1):
            if i<n-1:
                print('@',end='')
            else:
                print(' ',end='')
        for j in range((n-1)*i):
            print(' ',end='')
        for j in range(n):
            print('*',end='')
        for j in range((n-1)*n-(n-1)*i-(n-1)):
            print(' ',end='')
        for j in range(1):
            if i>0:
                print('@',end='')
            else:
                print(' ',end='')
        print()
    for i in range(n//2):
        for j in range((n-1)*n+2):
            print(' ',end='')
        for j in range(1):
            print('@',end='')
        print()
else:
    print('Invalid')
