n=9
for i in range(n//2+1):
    for j in range(n-i):
        print(" ",end="")
    for j in range(i+1):
        print("*",end="")  
    for j in range(i):
        print("*",end="")      
    print()  
for i in range(n):
    for j in range(n+n//2+1):
        if j==n:
            print("*",end="")
        else:
            print(" ",end="")
    print()   
for i in range(n):
    for j in range (n//2):
        print(" ",end="")
    for j in range(n+2):
        if i==0 or j==0 or j==n+1:
            print("*",end="") 
        else:
            print(" ",end="")       
    print() 
for i in range(n//2+1):
    for j in range(i+1-1):
        print(" ",end="")
    for j in range(n-i-i):
        print("*",end="")  
    for j in range(i+1):
        print(" ",end="")    
    for j in range(i+1-1):
        print(" ",end="")
    for j in range(n-i-i):
        print("*",end="") 
             
    print()         
                       
     
