n=7
if n%2==0:
    print("invalid")
else:
    
    for i in range(n-1):
        for j in range(n-i):
            print(" ",end="")
        for j in range(i+1):
            print("@",end="") 
        for j in range(i):
            print("@",end="")     
        print()   
    for i in range((n//2)+1):
        for j in range(n//2-i) :
            print(" ",end="")
        for j in range(i+1):
            print("&",end="")   
        for j in range(n):
            if i==n//2:
             print("@",end="")
            else:
             print(" ",end="")   
        for j in range(i+1):
            print("&",end="")      
        print() 
    for i in range(n//2):
        for j in range(i+1):
            print(' ',end="")
        for j in range(n//2-i):
            print("&",end="")  
        for j in range(n):
            print(" ",end="")    
        for j in range(n//2-i):
            print("&",end="")      
        print()    
                
        
